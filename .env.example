# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API base URL (optional when Vite/unified server is active)
VITE_API_URL=/api

# Backend Local Single-User Development Access Mode
# Enabled by default when NODE_ENV=development unless set to false.
# Always disabled automatically when NODE_ENV=production.
DEV_ACCESS_MODE=true

# Optional explicit Docker daemon socket path (e.g., //./pipe/docker_engine on Windows or /var/run/docker.sock on Linux)
DOCKER_SOCKET_PATH=
