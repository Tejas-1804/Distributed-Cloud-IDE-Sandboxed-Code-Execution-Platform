# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API base URL (optional when Vite/unified server is active)
VITE_API_URL=/api

# Backend Local Single-User Development Access Mode
# Enabled by default when NODE_ENV=development unless set to false.
# Always disabled automatically when NODE_ENV=production.
DEV_ACCESS_MODE=true

# Optional explicit Docker daemon socket path (e.g., //./pipe/docker_engine on Windows or /var/run/docker.sock on Linux)
DOCKER_SOCKET_PATH=

# Phase 3 Container Orchestration & Sandbox Limits
CONTAINER_MEMORY_LIMIT_MB=256
CONTAINER_CPU_LIMIT=0.5
CONTAINER_PIDS_LIMIT=64
CONTAINER_MAX_ACTIVE=10
CONTAINER_IDLE_TIMEOUT_MS=3600000
CONTAINER_NETWORK_MODE=none
CONTAINER_READONLY_ROOTFS=false

# Phase 5 Code Execution Engine Limits
EXECUTION_TIMEOUT_MS=10000
EXECUTION_COMPILE_TIMEOUT_MS=15000
EXECUTION_MAX_OUTPUT_BYTES=131072
EXECUTION_MAX_CONCURRENT_PER_USER=3
EXECUTION_HISTORY_SUMMARY_CHARS=4096

# Phase 6 Language Server Limits
LSP_MAX_PROCESSES=8
LSP_IDLE_TIMEOUT_MS=900000

