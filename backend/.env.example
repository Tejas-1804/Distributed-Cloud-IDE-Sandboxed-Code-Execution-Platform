PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/distributed_cloud_ide
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:3000

# Local single-user development access mode (no login UI required locally).
# Disabled automatically in NODE_ENV=production.
DEV_ACCESS_MODE=true

# Optional Docker Engine socket path (leave empty for OS default)
DOCKER_SOCKET_PATH=

# Terminal security & resource limits
TERMINAL_MAX_SESSIONS_PER_USER=6
TERMINAL_MAX_SESSIONS_PER_WORKSPACE=4
TERMINAL_IDLE_TIMEOUT_MS=1800000
TERMINAL_MAX_OUTPUT_BUFFER_BYTES=262144
TERMINAL_INPUT_RATE_LIMIT_PER_SEC=250
